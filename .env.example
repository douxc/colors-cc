# VPS deployment target
VPS_TARGET=deploy@example.com
VPS_ROOT=/var/www/colors-cc/html
VPS_SITE_ORIGIN=https://www.colors-cc.top

# Search platform verification values. Copy only the content value issued by
# each platform; do not paste the full <meta> tag.
SEO_GOOGLE_SITE_VERIFICATION=
SEO_BAIDU_SITE_VERIFICATION=
SEO_360_SITE_VERIFICATION=
SEO_BYTEDANCE_VERIFICATION_CODE=

# Optional JSON object for any additional platform-issued meta names.
# SEO_EXTRA_VERIFICATION_META={"sogou_site_verification":"issued-value"}
