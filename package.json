{
  "name": "colors-cc",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "wrangler dev",
    "build:worker": "WRANGLER_LOG_PATH=dist/wrangler.log wrangler deploy --dry-run --outdir dist/worker",
    "build:vps": "node --import tsx scripts/build-vps.ts",
    "build:all": "pnpm build:worker && pnpm build:vps",
    "deploy": "wrangler deploy",
    "deploy:worker": "pnpm validate && wrangler deploy",
    "deploy:vps": "sh scripts/deploy-vps.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "validate": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@jsquash/oxipng": "2.3.0",
    "hono": "^4.0.0",
    "libimagequant-wasm": "0.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240222.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.13.3",
    "esbuild": "0.27.3",
    "googleapis": "^128.0.0",
    "jsdom": "26.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.72.0"
  }
}
