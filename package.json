{
  "name": "colors-cc",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "wrangler dev",
    "build:worker": "WRANGLER_LOG_PATH=dist/wrangler.log wrangler deploy --dry-run --outdir dist/worker",
    "build:vps": "tsx scripts/build-vps.ts",
    "build:all": "pnpm build:worker && pnpm build:vps",
    "deploy": "wrangler deploy",
    "deploy:worker": "pnpm validate && wrangler deploy",
    "deploy:vps": "sh scripts/deploy-vps.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240222.0",
    "googleapis": "^128.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.72.0"
  }
}
